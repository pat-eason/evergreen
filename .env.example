# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# --- Local: nothing needs to be set ---
# `docker compose up --build`, then open http://localhost:8080

# --- Production (shared droplet) ---
# The GitHub Actions deploy creates /opt/evergreen/.env on the FIRST deploy only, with:
#   POSTGRES_PASSWORD=<random>      Postgres reads it only when its volume is first created,
#                                   so the file is never overwritten. Keep a copy somewhere safe.
#   COMPOSE_PROJECT_NAME=evergreen  pins the data volume name (evergreen_pgdata)
#   COMPOSE_FILE=docker-compose.yml:docker-compose.prod.yml
# and keeps these two current (don't edit):
#   REGISTRY=ghcr.io/pat-eason
#   TAG=<commit sha>
# See DEPLOY.md.

# --- Optional ---

# Database password for local use (default "evergreen"). Letters and digits only, so it is URL-safe.
# POSTGRES_PASSWORD=

# Registration: open (anyone), invite (needs REGISTRATION_INVITE_CODE) or closed (nobody new, once the
# first account exists). Production takes both from the GitHub secrets of the same names on every deploy
# (mode defaults to closed when the secret is unset).
# REGISTRATION_MODE=open
# REGISTRATION_INVITE_CODE=

# Use an external Postgres (e.g. a DigitalOcean Managed Database) instead of the bundled one.
# DATABASE_URL=postgres://user:password@host:25060/evergreen?sslmode=require

# Session cookie. Production sets COOKIE_SECURE=true and COOKIE_PATH=/evergreen via docker-compose.prod.yml.
# COOKIE_SECURE=true
# COOKIE_PATH=/

# Public path of the SPA, a build argument (default "/"; the droplet image is built with /evergreen/).
# BASE_PATH=/

# Standalone use only: your own domain and Let's Encrypt via the web container's Caddy.
# On the shared droplet the prod overlay pins SITE_ADDRESS=:80 and the shared proxy does HTTPS.
# SITE_ADDRESS=wellness.example.com
# HTTP_PORT=8080
# HTTPS_PORT=8443

# Host port for the bundled database (127.0.0.1 only, local use; not published in production).
# POSTGRES_PORT=5432

# Backups written by deploy/backup.sh (defaults shown).
# BACKUP_DIR=./backups
# BACKUP_KEEP=14
