# Copy to .env next to docker-compose.yml. Compose reads it automatically.

# --- Local: nothing needs to be set ---
# `docker compose up --build`, then open http://localhost:8080

# --- Production on a droplet ---

# Database password. REQUIRED in production (the deploy refuses to run without it).
# Use letters and digits only, so it is safe inside a URL:  openssl rand -hex 24
# It is applied when the database is first created; changing it later does not change
# the existing database's password.
# POSTGRES_PASSWORD=

# Your domain, with an A record pointing at the droplet. Caddy gets a
# Let's Encrypt certificate for it automatically.
# SITE_ADDRESS=wellness.example.com
# HTTP_PORT=80
# HTTPS_PORT=443

# Lock sign-ups once you've created your account (the first account can always
# be created). Anyone else who finds the URL cannot register.
# ALLOW_REGISTRATION=false

# --- Optional ---

# Use an external Postgres (e.g. a DigitalOcean Managed Database) instead of the bundled one.
# DATABASE_URL=postgres://user:password@host:25060/evergreen?sslmode=require

# Host port for the bundled database (bound to 127.0.0.1 only; for local tools).
# POSTGRES_PORT=5432

# Backups written by deploy/backup.sh (defaults shown).
# BACKUP_DIR=./backups
# BACKUP_KEEP=14

# --- Written automatically by the GitHub Actions deploy; don't edit ---
# COMPOSE_PROJECT_NAME=evergreen   # pins the data volume name (evergreen_pgdata)
# TAG=                             # image version currently running
# REGISTRY=ghcr.io/pat-eason       # where images are pulled from
