{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": "sh",
      "runtimeArgs": [
        "-c",
        "DATABASE_URL='postgres://evergreen:evergreen@localhost:5432/evergreen?sslmode=disable' exec go -C backend run ."
      ],
      "port": 8081
    },
    {
      "name": "web",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": [
        "--dir",
        "frontend",
        "dev",
        "--host",
        "127.0.0.1"
      ],
      "port": 5173
    }
  ]
}